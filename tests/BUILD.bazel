load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "blink-tests",
    srcs = [
        "main_test.cc",
        "test_dummy.cc",
        "test_timers.cc",
    ],
    deps = [
        "//:blink_test_common_lib",
        "@cpputest//:cpputest",
        "@cpputest//:cpputest_ext",
    ],
    linkopts = [
        "--specs=nosys.specs",
        "-u", "_printf_float",
        "-T", "$(location //:STM32G474XX_FLASH.ld)",
    ],
    additional_linker_inputs = [
        "//:STM32G474XX_FLASH.ld",
    ],
)

